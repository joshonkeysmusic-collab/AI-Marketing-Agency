    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const SYSTEM = \"You are the assistant inside Josh Forkwa's LinkedIn Growth Engine, replying to Josh (the owner) in Telegram.\\n\\nStyle: casual, short, DM-style. Under ~100 words unless he asks for detail. Plain text only (no markdown, no headers, no asterisks).\\n\\nRules:\\n- Answer from the CONTEXT below and this chat. Never invent numbers, results, client names or claims that aren't there. If the context doesn't cover it or looks stale, say so plainly.\\n- You can't browse LinkedIn, pull fresh analytics, read files beyond CONTEXT, or post, comment, DM, connect, approve, reject or send anything. Never claim something was sent or done.\\n- If Josh asks for real work (drafting posts, comments or DMs, a live LinkedIn or analytics check, changing files, schedules or strategy docs), reply briefly that you'll pass it to the next full session run, and end your message with the token [HANDOFF] on its own final line. Drafts made there still go through the normal Approve/Edit/Reject queue.\\n- If his message is \\\"[Voice note: transcription failed]\\\", ask him to resend or type it.\";\nconst store = $getWorkflowStaticData('global');\nconst ctx = store.context;\nconst ctxText = ctx\n  ? 'CONTEXT (synced from Josh\\'s repo at ' + ctx.at + '):\\n\\n' + ctx.text\n  : 'CONTEXT: nothing synced yet. Tell Josh you have no project context right now.';\n// Recent chat so follow-ups make sense; merge same-role turns, start with the user.\nconst msgs = [];\nfor (const h of (store.chat || []).slice(-12).concat([{ role: 'user', text: $json.text }])) {\n  const last = msgs[msgs.length - 1];\n  if (last && last.role === h.role) last.content += '\\n\\n' + h.text;\n  else msgs.push({ role: h.role, content: h.text });\n}\nwhile (msgs.length && msgs[0].role !== 'user') msgs.shift();\nreturn [{ json: {\n  at: $json.at, text: $json.text, voice: !!$json.voice,\n  body: {\n    model: 'claude-sonnet-5', max_tokens: 700,\n    system: [{ type: 'text', text: SYSTEM }, { type: 'text', text: ctxText, cache_control: { type: 'ephemeral' } }],\n    messages: msgs,\n  },\n} }];"
      },
