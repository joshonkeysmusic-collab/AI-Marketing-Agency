    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const req = $('Build Claude Request').first().json;\nconst out = (($json.content) || []).filter(c => c.type === 'text').map(c => c.text).join('').trim();\nconst failed = !out;\nlet handoff = failed || /\\[HANDOFF\\]\\s*$/.test(out);\nconst spoken = failed\n  ? \"Couldn't reach Claude just now. I'll pick this up on the next scheduled run instead.\"\n  : out.replace(/\\[HANDOFF\\]\\s*$/, '').trim();\nlet reply = spoken;\nif (req.voice) reply = '🎙️ Heard: \"' + req.text + '\"\\n\\n' + reply;\n\nconst store = $getWorkflowStaticData('global');\nconst now = new Date().toISOString();\nstore.chat = (store.chat || []).concat(\n  [{ role: 'user', text: req.text, at: req.at }],\n  failed ? [] : [{ role: 'assistant', text: spoken, at: now }]\n).slice(-20);\n// Tell the local scheduled task what the bot already did, so it doesn't answer twice.\nstore.messages = store.messages || [];\nconst flags = { bot_pending: false, bot_replied: !failed, handoff, bot_reply: failed ? '' : reply };\nconst m = store.messages.find(x => x.at === req.at);\nif (m) Object.assign(m, flags);\nelse store.messages.push({ text: req.text, at: req.at, voice: req.voice, ...flags });\n// Voice in, voice out: the text reply always goes, plus a spoken copy when Josh sent a voice note.\nreturn [{ json: { reply: reply.slice(0, 4000), voice: !!req.voice && !failed, spoken: spoken.slice(0, 4000) } }];"
