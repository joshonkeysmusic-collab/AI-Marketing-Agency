        "language": "javaScript",
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.decisions = store.decisions || [];\nstore.messages = store.messages || [];\nconst q = $json.callback_query;\nconst m = $json.message;\nif (q) {\nif (!q.from || q.from.id !== 7406832850) return [];\nconst parts = (q.data || '').split('|');\nconst a = parts[0], batch_id = parts[1], item_id = parts[2];\nif (a === 'e') {\nstore.awaitingEdit = { batch_id: batch_id, item_id: item_id };\nreturn [{ json: { kind: 'callback', query_id: q.id, decision: 'awaiting_edit', batch_id: batch_id, item_id: item_id, toast: 'Send the new text as your next message' } }];\n}\nconst decision = a === 'a' ? 'approved' : a === 'r' ? 'rejected' : 'unknown';\nstore.decisions.push({ batch_id: batch_id, item_id: item_id, decision: decision, at: new Date().toISOString() });\nstore.awaitingEdit = null;\nreturn [{ json: { kind: 'callback', query_id: q.id, decision: decision, batch_id: batch_id, item_id: item_id, toast: decision === 'approved' ? 'Approved' : 'Rejected' } }];\n}\nif (m) {\nif (!m.from || m.from.id !== 7406832850) return [];\nconst text = (m.text || m.caption || '').trim();\nconst voice = !!m.voice_transcript;\nif (store.awaitingEdit) {\nconst batch_id = store.awaitingEdit.batch_id, item_id = store.awaitingEdit.item_id;\nstore.decisions.push({ batch_id: batch_id, item_id: item_id, decision: 'edited', text: text, at: new Date().toISOString() });\nstore.awaitingEdit = null;\nreturn [{ json: { kind: 'message', handled: 'edit', batch_id: batch_id, item_id: item_id, text: text, voice: voice } }];\n}\nconst at = new Date().toISOString();\n// bot_pending: the n8n bot is answering this one; the local scheduled task should leave it alone.\nstore.messages.push({ text: text, at: at, voice: voice, bot_pending: !!text });\nreturn [{ json: { kind: 'message', handled: 'note', text: text, at: at, voice: voice } }];\n}\nreturn [];",
        "notice": ""
