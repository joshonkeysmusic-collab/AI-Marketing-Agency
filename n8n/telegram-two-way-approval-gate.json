        "language": "javaScript",
        "jsCode": "// Turn the voice note back into a normal text message so the rest of the flow treats it the same.\nconst orig = $('Button Tapped (Telegram)').first().json;\nconst heard = ($json.text || '').trim();\nconst text = heard || '[Voice note: transcription failed]';\nreturn [{ json: { ...orig, message: { ...orig.message, text, voice_transcript: true } } }];"
