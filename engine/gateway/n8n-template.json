    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalise the request: {batch_id, item_id, type, target, text, media_url?, media_type?}\nconst b = $json.body || $json;\nconst label = {post:'📝 Post', comment:'💬 Comment', reply:'↩️ Reply', dm:'✉️ DM', connect:'🤝 Connection request', lead:'📄 PDF delivery'}[b.type] || b.type;\nconst head = [label, b.target].filter(Boolean).join(' · ');\nreturn [{ json: {\n  batch_id: b.batch_id, item_id: b.item_id,\n  message: `${head}\\n\\n${b.text || ''}`.slice(0, 1000),\n  media_url: b.media_url || '',\n  media_type: b.media_type || (b.media_url ? 'photo' : 'none'),\n  approve: `a|${b.batch_id}|${b.item_id}`,\n  edit: `e|${b.batch_id}|${b.item_id}`,\n  reject: `r|${b.batch_id}|${b.item_id}`\n}}];"
      },
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-112, -736]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1},
                "conditions": [{"leftValue": "={{ $json.media_type }}", "rightValue": "video", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "video"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1},
                "conditions": [{"leftValue": "={{ $json.media_type }}", "rightValue": "photo", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "photo"
            }
          ]
        },
        "options": {"fallbackOutput": "extra", "renameFallbackOutput": "text"}
      },
      "name": "Media Type?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [112, -736]
