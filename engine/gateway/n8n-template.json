      },
      "name": "Owner Tapped or Messaged",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-336, -240],
      "webhookId": "approval-callbacks-{{TENANT_SLUG}}"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Only the owner's chat may act. OWNER_CHAT_ID is substituted at import time.\nconst OWNER = {{OWNER_CHAT_ID}};\nconst store = $getWorkflowStaticData('global');\nstore.decisions = store.decisions || [];\nstore.messages = store.messages || [];\nconst q = $json.callback_query;\nconst m = $json.message;\nif (q) {\n  if (!q.from || q.from.id !== OWNER) return [];\n  const parts = (q.data || '').split('|');\n  const a = parts[0], batch_id = parts[1], item_id = parts[2];\n  if (a === 'e') {\n    store.awaitingEdit = { batch_id, item_id };\n    return [{ json: { kind: 'callback', query_id: q.id, decision: 'awaiting_edit', batch_id, item_id, toast: 'Send the new text as your next message' } }];\n  }\n  const decision = a === 'a' ? 'approved' : a === 'r' ? 'rejected' : 'unknown';\n  store.decisions.push({ batch_id, item_id, decision, at: new Date().toISOString() });\n  store.awaitingEdit = null;\n  return [{ json: { kind: 'callback', query_id: q.id, decision, batch_id, item_id, toast: decision === 'approved' ? 'Approved' : 'Rejected' } }];\n}\nif (m) {\n  if (!m.from || m.from.id !== OWNER) return [];\n  const text = (m.text || m.caption || '').trim();\n  if (store.awaitingEdit) {\n    const { batch_id, item_id } = store.awaitingEdit;\n    store.decisions.push({ batch_id, item_id, decision: 'edited', text, at: new Date().toISOString() });\n    store.awaitingEdit = null;\n    return [{ json: { kind: 'message', handled: 'edit', batch_id, item_id, text } }];\n  }\n  store.messages.push({ text, at: new Date().toISOString() });\n  return [{ json: { kind: 'message', handled: 'note', text } }];\n}\nreturn [];"
      },
      "name": "Record Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-112, -240]
